{
  "openapi": "3.0.3",
  "info": {
    "title": "Kazer Universal API",
    "version": "0.1.0",
    "description": "Discovery API for the public Kazer Universal MVP. Capability execution is disabled until a provider is configured."
  },
  "paths": {
    "/v1/health": { "get": { "responses": { "200": { "description": "Platform health" } } } },
    "/v1/capabilities": { "get": { "responses": { "200": { "description": "Declared capabilities" } } } },
    "/v1/registry": { "get": { "responses": { "200": { "description": "Registry entries with license and provenance metadata" } } } },
    "/v1/skills": { "get": { "responses": { "200": { "description": "Declared skills" } } } },
    "/v1/models": { "get": { "responses": { "200": { "description": "Configured models, empty in the MVP" } } } },
    "/v1/providers": { "get": { "responses": { "200": { "description": "Configured providers, empty in the MVP" } } } },
    "/v1/adapters": { "get": { "responses": { "200": { "description": "Public adapter catalog without secrets" } } } },
    "/v1/adapters/{id}/health": { "get": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "enum": ["llama-cpp", "qwen3", "deepseek-r1"] } }], "responses": { "200": { "description": "Adapter readiness and exact model identity" }, "404": { "description": "Unknown adapter" } } } },
    "/v1/adapters/{id}/chat": { "post": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "enum": ["llama-cpp", "qwen3", "deepseek-r1"] } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["messages"], "properties": { "model": { "type": "string" }, "messages": { "type": "array" }, "max_tokens": { "type": "integer", "maximum": 8192 }, "temperature": { "type": "number" }, "stream": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "Upstream OpenAI-compatible response" }, "401": { "description": "Kazer API key required when database is active" }, "501": { "description": "Adapter not configured" }, "502": { "description": "Upstream adapter error" } } } },
    "/v1/repository/inspect": { "post": { "summary": "Read public GitHub repository metadata safely", "description": "Reads public README, license files and text manifests without cloning or executing external code. Only HTTPS github.com repository URLs are accepted.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } } } } }, "responses": { "200": { "description": "Inspection result with license, suggested skills, capabilities and evidence" }, "400": { "description": "Invalid or disallowed repository URL" }, "502": { "description": "Public metadata could not be read" } } } },
    "/v1/chat": { "post": { "responses": { "501": { "description": "No provider configured" } } } },
    "/v1/reason": { "post": { "responses": { "501": { "description": "No provider configured" } } } },
    "/v1/agent": { "post": { "responses": { "501": { "description": "No provider configured" } } } },
    "/v1/image": { "post": { "responses": { "501": { "description": "No provider configured" } } } }
  }
}
