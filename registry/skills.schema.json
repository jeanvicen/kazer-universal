{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kazer Skill Manifest",
  "type": "object",
  "required": ["name", "version", "capabilities", "permissions", "license", "entrypoint"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string", "minLength": 1 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
